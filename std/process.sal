module salivo.std.process;

// Salivo Standard Library: Process Module

// Exits the process. Uses rtpanic as the underlying termination
// mechanism since that's the only runtime intrinsic with exit() support.
pub func exit(int code) {
    rtexit(code);
}

pub func cwd() -> string {
    return rtprocesscwd();
}

pub func system(string cmd) -> int {
    return rtsystem(cmd);
}

/// Splits an LLVM IR file into per-core parts (<path>.p<k>.ll) for parallel compilation.
/// Returns the part count (one per CPU when parts <= 0), or 0 when the file could not be split.
/// A module too small to split becomes a single part (count 1) in which every function but main
/// is internal, for whole-program optimization.
pub func splitIrModule(path: string, parts: int) -> int {
    return rtsplitirmodule(path, parts);
}

/// Runs newline-separated shell commands concurrently; returns 0 when all succeed, else the first failing exit code.
pub func runParallel(cmds: string) -> int {
    return rtrunparallel(cmds);
}


// ---- Running commands and capturing their output (like Python's subprocess.run) ----

/// What a finished command produced
pub struct ProcessResult {
    int code;
    string stdout;
    string stderr;
    bool started;
}

/// Runs cmd through the system shell (cmd.exe or /bin/sh) and waits; stdout and stderr captured
pub func run(cmd: string) -> ProcessResult { return runInput(cmd, ""); }

/// Like run, with input fed to the command's stdin
pub func runInput(cmd: string, input: string) -> ProcessResult {
    let h = rtsysrun(cmd, input);
    if (h <= 0) { return ProcessResult { code: 0 - 1, stdout: "", stderr: "could not start: " + cmd, started: false }; }
    let res = ProcessResult { code: rtsysruncode(h), stdout: rtsysrunout(h), stderr: rtsysrunerr(h), started: true };
    let f = rtsysrunfree(h);
    return res;
}

/// stdout of cmd with trailing newlines removed (like $(cmd) in a shell); "" when it fails
pub func output(cmd: string) -> string {
    let r = run(cmd);
    let mut s = r.stdout;
    while (len(s) > 0 && (endswith(s, "\n") || endswith(s, "\r"))) { s = slice(s, 0, len(s) - 1); }
    return s;
}

/// True when cmd ran and exited with code 0
pub func succeeded(r: ProcessResult) -> bool { return r.started && r.code == 0; }

/// Sets an environment variable for this process and the processes it starts; 0 on success, -1 on failure
pub func envSet(key: string, value: string) -> int { return rtenvset(key, value); }
/// Removes an environment variable; 0 on success, -1 on failure
pub func envUnset(key: string) -> int { return rtenvunset(key); }
/// Every environment variable as "KEY=VALUE" lines
pub func envList() -> string { return rtenvlist(); }

// ---- Child processes with streaming pipes ----
// A child is an int handle (> 0). Release it with childFree, which also stops a child still running.

/// Starts cmd through the system shell with pipes on its stdin, stdout and stderr; a handle, or -1
pub func childStart(cmd: string) -> int { return rtchildopen(cmd); }
/// Writes text to the child's stdin; bytes written, or -1 once its input is closed or it has exited
pub func childWrite(child: int, text: string) -> int { return rtchildwrite(child, text); }
/// Closes the child's stdin so it sees end of input
pub func childCloseInput(child: int) -> int { return rtchildcloseinput(child); }
/// stdout that has arrived, waiting up to timeoutMs (< 0 forever) for the first bytes; "" on timeout or at the end
pub func childRead(child: int, timeoutMs: int) -> string { return rtchildread(child, 0, timeoutMs); }
/// Like childRead, for stderr
pub func childReadErr(child: int, timeoutMs: int) -> string { return rtchildread(child, 1, timeoutMs); }
/// True once the child's stdout has ended (it exited or closed it)
pub func childDone(child: int) -> bool { return rtchildeof(child, 0) == 1; }
/// Waits up to timeoutMs (< 0 forever) for the child to exit: its exit code, or -1 while it still runs
pub func childWait(child: int, timeoutMs: int) -> int { return rtchildwait(child, timeoutMs); }
/// Stops the child
pub func childKill(child: int) -> int { return rtchildkill(child); }
/// Releases the handle and its pipes (stopping the child first if it still runs)
pub func childFree(child: int) -> int { return rtchildfree(child); }

/// Everything the child writes to stdout until it ends
pub func childReadAll(child: int) -> string {
    let mut out = "";
    while (!childDone(child)) { out = out + childRead(child, 0 - 1); }
    return out;
}
