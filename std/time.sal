module salivo.std.time;
><salivo.std.core::{panic, assert, asserteq, Option, some, none, Result, ok, err};
><salivo.std.strings::{String};

/// =============================================================================
/// SALIVO STANDARD LIBRARY: TIME & TIMERS (std/time.sal)
///
/// Production Duration, Instant, Date, Time, DateTime, Timezone, Timer, and Stopwatch.
/// Backed by high-precision OS monotonic clock and calendar routines.
/// =============================================================================

// -----------------------------------------------------------------------------
// Time Abstraction Structs
// -----------------------------------------------------------------------------

pub struct Duration {
    int seconds;
    int nanoseconds;
}

pub func duration(sec: int, nanos: int) -> Duration {
    return Duration {
        seconds: sec,
        nanoseconds: nanos,
    };
}

pub func fromms(ms: int) -> Duration {
    let sec = ms / 1000;
    let rem_ms = ms % 1000;
    return Duration {
        seconds: sec,
        nanoseconds: rem_ms * 1000000,
    };
}

pub struct Instant {
    int ticks_nanos;
}

pub struct Date {
    int year;
    int month;
    int day;
}

pub struct Time {
    int hour;
    int minute;
    int second;
    int nanosecond;
}

pub struct DateTime {
    Date date;
    Time time;
    int offset_seconds;
}

pub struct Timezone {
    string name;
    int offset_seconds;
}

pub struct Timer {
    int id;
    Duration interval;
    bool is_active;
}

pub struct Stopwatch {
    Instant start_instant;
    bool is_running;
}

// -----------------------------------------------------------------------------
// Time Operations
// -----------------------------------------------------------------------------

pub func now() -> Instant {
    let ticks = rtclocknanos();
    return Instant { ticks_nanos: ticks };
}

pub func epoch() -> int {
    return rttimenowms();
}

pub func elapsed(Instant start_t) -> Duration {
    let current_t = now();
    let diff_nanos = current_t.ticks_nanos - start_t.ticks_nanos;
    if (diff_nanos < 0) {
        diff_nanos = 0;
    }
    let sec = diff_nanos / 1000000000;
    let rem_nanos = diff_nanos % 1000000000;
    return Duration {
        seconds: sec,
        nanoseconds: rem_nanos,
    };
}

pub func sleepdur(Duration dur) {
    if (dur.seconds < 0) {
        return;
    }
    let total_nanos = dur.seconds * 1000000000 + dur.nanoseconds;
    rtsleepnanos(total_nanos);
}

pub func sleep(int ms) {
    rtsleepms(ms);
}

pub func sleepuntil(int target_time_ms) {
    let current_ms = rttimenowms();
    if (target_time_ms > current_ms) {
        rtsleepms(target_time_ms - current_ms);
    }
}

pub func timer(int delay_ms) -> Timer {
    let dur = fromms(delay_ms);
    let t_id = rttimercreate(delay_ms);
    return Timer {
        id: t_id,
        interval: dur,
        is_active: t_id != 0,
    };
}

pub func isactive(Timer t) -> bool {
    let res = rttimerisactive(t.id);
    return res != 0;
}

pub func canceltimer(Timer t) -> bool {
    let res = rttimercancel(t.id);
    return res != 0;
}

pub func processtimers() -> int {
    return rtruntimeprocesstimers();
}

pub func addduration(Duration d1, Duration d2) -> Duration {
    let total_nanos = d1.nanoseconds + d2.nanoseconds;
    let extra_sec = total_nanos / 1000000000;
    let rem_nanos = total_nanos % 1000000000;
    return Duration {
        seconds: d1.seconds + d2.seconds + extra_sec,
        nanoseconds: rem_nanos,
    };
}

pub func subduration(Duration d1, Duration d2) -> Duration {
    let sec_diff = d1.seconds - d2.seconds;
    let nanos_diff = d1.nanoseconds - d2.nanoseconds;
    if (nanos_diff < 0) {
        sec_diff = sec_diff - 1;
        nanos_diff = nanos_diff + 1000000000;
    }
    if (sec_diff < 0) {
        return Duration { seconds: 0, nanoseconds: 0 };
    }
    return Duration {
        seconds: sec_diff,
        nanoseconds: nanos_diff,
    };
}

pub func diffinstant(Instant i1, Instant i2) -> Duration {
    let diff = i1.ticks_nanos - i2.ticks_nanos;
    if (diff < 0) {
        diff = -diff;
    }
    return Duration {
        seconds: diff / 1000000000,
        nanoseconds: diff % 1000000000,
    };
}

func pad2(int v) -> string {
    if (v < 10 && v >= 0) {
        return "0" + intstr(v);
    }
    return intstr(v);
}

func pad4(int v) -> string {
    let s = intstr(v);
    let slen = rtstrlen(s);
    if (slen == 1) { return "000" + s; }
    if (slen == 2) { return "00" + s; }
    if (slen == 3) { return "0" + s; }
    return s;
}

/// strftime-style formatting: %Y %m %d %H %M %S %%; other characters are copied.
/// An empty format yields ISO 8601 UTC (YYYY-MM-DDTHH:MM:SSZ).
pub func format(DateTime dt, string fmt_str) -> string {
    let mut fmt = fmt_str;
    if (fmt == "") { fmt = "%Y-%m-%dT%H:%M:%SZ"; }
    let n = len(fmt);
    let mut out = "";
    let mut i = 0;
    while (i < n) {
        let c = slice(fmt, i, i + 1);
        if (c == "%" && i + 1 < n) {
            let d = slice(fmt, i + 1, i + 2);
            if (d == "Y") { out = out + pad4(dt.date.year); }
            else if (d == "m") { out = out + pad2(dt.date.month); }
            else if (d == "d") { out = out + pad2(dt.date.day); }
            else if (d == "H") { out = out + pad2(dt.time.hour); }
            else if (d == "M") { out = out + pad2(dt.time.minute); }
            else if (d == "S") { out = out + pad2(dt.time.second); }
            else if (d == "%") { out = out + "%"; }
            else { out = out + c + d; }
            i = i + 2;
        } else {
            out = out + c;
            i = i + 1;
        }
    }
    return out;
}

// Reads exactly `width` ASCII digits at `pos`; -1 if any is not a digit or input is short
func readDigits(string s, int pos, int width) -> int {
    if (pos + width > len(s)) { return -1; }
    let mut v = 0;
    let mut k = 0;
    while (k < width) {
        let ch = slice(s, pos + k, pos + k + 1);
        if (ch < "0" || ch > "9") { return -1; }
        v = v * 10 + strint(ch);
        k = k + 1;
    }
    return v;
}

/// Parses `date_str` with the same directives as format (fixed width: %Y=4, others 2).
/// Literal characters must match. An empty format accepts ISO 8601 date or date-time.
pub func parse(string date_str, string fmt_str) -> Result<DateTime, string> {
    let mut fmt = fmt_str;
    if (fmt == "") {
        if (len(date_str) <= 10) { fmt = "%Y-%m-%d"; }
        else if (len(date_str) == 19) { fmt = "%Y-%m-%dT%H:%M:%S"; }
        else { fmt = "%Y-%m-%dT%H:%M:%SZ"; }
    }
    let n = len(fmt);
    let mut pos = 0;
    let mut i = 0;
    let mut yr = 1970;
    let mut mo = 1;
    let mut dy = 1;
    let mut hr = 0;
    let mut mn = 0;
    let mut sc = 0;
    while (i < n) {
        let c = slice(fmt, i, i + 1);
        if (c == "%" && i + 1 < n && slice(fmt, i + 1, i + 2) != "%") {
            let d = slice(fmt, i + 1, i + 2);
            let mut width = 2;
            if (d == "Y") { width = 4; }
            let v = readDigits(date_str, pos, width);
            if (v < 0) { return err<DateTime, string>("Invalid date string: expected digits for %" + d); }
            if (d == "Y") { yr = v; }
            else if (d == "m") { mo = v; }
            else if (d == "d") { dy = v; }
            else if (d == "H") { hr = v; }
            else if (d == "M") { mn = v; }
            else if (d == "S") { sc = v; }
            else { return err<DateTime, string>("Unsupported directive %" + d); }
            pos = pos + width;
            i = i + 2;
        } else {
            let lit = c;
            if (c == "%") { i = i + 1; }
            if (pos >= len(date_str) || slice(date_str, pos, pos + 1) != lit) {
                return err<DateTime, string>("Invalid date string: expected '" + lit + "'");
            }
            pos = pos + 1;
            i = i + 1;
        }
    }
    if (pos != len(date_str)) { return err<DateTime, string>("Invalid date string: trailing characters"); }
    if (mo < 1 || mo > 12 || dy < 1 || dy > 31 || hr > 23 || mn > 59 || sc > 60) {
        return err<DateTime, string>("Invalid date string: field out of range");
    }
    let d = Date { year: yr, month: mo, day: dy };
    let t = Time { hour: hr, minute: mn, second: sc, nanosecond: 0 };
    return ok<DateTime, string>(DateTime { date: d, time: t, offset_seconds: 0 });
}

pub func testtime() -> bool {
    let t = now();
    let d = fromms(100);
    return d.nanoseconds == 100000000;
}
