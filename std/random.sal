// Salivo Standard Library: Random Module
// Pseudo-random numbers for simulations and games, never for secrets (use salivo.std.crypto randBytes).
module salivo.std.random;

/// Non-negative pseudo-random integer, uniform over 0 .. 2^63 - 1
pub func rand() -> int {
    return rtrandomint();
}

/// Uniform integer in min_val ..= max_val (min_val when the range is empty)
pub func randrange(int min_val, int max_val) -> int {
    if (min_val >= max_val) {
        return min_val;
    }
    let span = max_val - min_val + 1;
    if (span <= 0) {
        // The range is wider than 2^63 (span overflowed): draw full 64-bit values until one is in range
        let mut v = rand() * 2 + rand() % 2;
        while (v < min_val || v > max_val) {
            v = rand() * 2 + rand() % 2;
        }
        return v;
    }
    // Rejection sampling: only draws below the largest multiple of span keep every value equally likely
    let top = 9223372036854775807;
    let limit = top - top % span;
    let mut r = rand();
    while (r >= limit) {
        r = rand();
    }
    return min_val + r % span;
}

/// Uniform float in 0.0 .. 1.0 (1.0 excluded) with 53 bits of precision
pub func randfloat() -> float {
    let r = rand() / 1024;
    return r / 9007199254740992.0;
}
