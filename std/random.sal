// Salivo Standard Library: Random Module
module salivo.std.random;

pub func rand() -> int {
    return rtrandomint();
}

pub func randrange(int min_val, int max_val) -> int {
    if (min_val >= max_val) {
        return min_val;
    }
    let r = rand();
    if (r < 0) { r = -r; }
    return min_val + (r % (max_val - min_val + 1));
}

pub func randfloat() -> float {
    let r = rand();
    if (r < 0) { r = -r; }
    return (r % 10000) / 10000.0;
}
