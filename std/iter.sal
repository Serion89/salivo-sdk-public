// Salivo Standard Library: Iterator Module
module salivo.std.iter;
><salivo.std.core::{Option, some, none};
><salivo.std.collections::{Vec, vecNew, push, get, set, veclen};

pub struct RangeIterator {
    int current;
    int end_val;
    int step_val;
}

pub func rangeiter(start_val: int, end_val: int, step_val: int) -> RangeIterator {
    return RangeIterator {
        current: start_val,
        end_val: end_val,
        step_val: step_val,
    };
}

pub func next(iter: RangeIterator) -> Option<int> {
    if (iter.current >= iter.end_val) {
        return none<int>();
    }
    let val = iter.current;
    iter.current = iter.current + iter.step_val;
    return some<int>(val);
}

// -----------------------------------------------------------------------------
// Vec algorithms over function values
// A function value is a plain function passed by name (`filterVec<int>(v, isEven)`). It receives each
// element as its 64-bit value, so it fits Vec<int>, Vec<bool>, Vec<string> and handle elements:
// predicates and mappers are func(T) -> int (non-zero = true), comparators func(T, T) -> int.
// -----------------------------------------------------------------------------

/// New Vec of f(x) for every x of v
pub func mapInts(v: Vec<int>, f: int) -> Vec<int> {
    let mut out = vecNew<int>();
    let n = veclen<int>(v);
    let mut i = 0;
    while (i < n) {
        out = push<int>(out, rtcallfn1(f, get<int>(v, i)));
        i = i + 1;
    }
    return out;
}

/// New Vec<int> of f(x) for every x of v
pub func mapToInts<T>(v: Vec<T>, f: int) -> Vec<int> {
    let mut out = vecNew<int>();
    let n = veclen<T>(v);
    let mut i = 0;
    while (i < n) {
        out = push<int>(out, rtcallfn1(f, get<T>(v, i)));
        i = i + 1;
    }
    return out;
}

/// New Vec of the elements of v for which pred(x) is non-zero, in order
pub func filterVec<T>(v: Vec<T>, pred: int) -> Vec<T> {
    let mut out = vecNew<T>();
    let n = veclen<T>(v);
    let mut i = 0;
    while (i < n) {
        let x = get<T>(v, i);
        if (rtcallfn1(pred, x) != 0) {
            out = push<T>(out, x);
        }
        i = i + 1;
    }
    return out;
}

/// f(...f(f(init, v[0]), v[1])..., v[n-1]); init for an empty Vec
pub func reduceVec<T>(v: Vec<T>, init: int, f: int) -> int {
    let mut acc = init;
    let n = veclen<T>(v);
    let mut i = 0;
    while (i < n) {
        acc = rtcallfn2(f, acc, get<T>(v, i));
        i = i + 1;
    }
    return acc;
}

/// Index of the first element for which pred(x) is non-zero, or -1
pub func findIndex<T>(v: Vec<T>, pred: int) -> int {
    let n = veclen<T>(v);
    let mut i = 0;
    while (i < n) {
        if (rtcallfn1(pred, get<T>(v, i)) != 0) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

/// Number of elements for which pred(x) is non-zero
pub func countVec<T>(v: Vec<T>, pred: int) -> int {
    let n = veclen<T>(v);
    let mut c = 0;
    let mut i = 0;
    while (i < n) {
        if (rtcallfn1(pred, get<T>(v, i)) != 0) { c = c + 1; }
        i = i + 1;
    }
    return c;
}

/// True when pred(x) is non-zero for some element
pub func anyVec<T>(v: Vec<T>, pred: int) -> bool {
    return findIndex<T>(v, pred) >= 0;
}

/// True when pred(x) is non-zero for every element (true for an empty Vec)
pub func allVec<T>(v: Vec<T>, pred: int) -> bool {
    return countVec<T>(v, pred) == veclen<T>(v);
}

/// Sorts v in place by cmp(a, b) (negative: a first, positive: b first, 0: keep order) and returns it.
/// Stable bottom-up merge sort, O(n log n) comparisons
pub func sortBy<T>(v: Vec<T>, cmp: int) -> Vec<T> {
    let n = veclen<T>(v);
    if (n < 2) { return v; }
    let mut src = v;
    let mut tmp = vecNew<T>();
    let mut i = 0;
    while (i < n) {
        tmp = push<T>(tmp, get<T>(v, i));
        i = i + 1;
    }
    let mut dst = tmp;
    let mut width = 1;
    let mut in_v = true; // the sorted runs are in v (src) and are merged into dst
    while (width < n) {
        let mut lo = 0;
        while (lo < n) {
            let mut mid = lo + width;
            if (mid > n) { mid = n; }
            let mut hi = lo + 2 * width;
            if (hi > n) { hi = n; }
            let mut a = lo;
            let mut b = mid;
            let mut k = lo;
            while (k < hi) {
                if (a < mid && (b >= hi || rtcallfn2(cmp, get<T>(src, b), get<T>(src, a)) >= 0)) {
                    set<T>(dst, k, get<T>(src, a));
                    a = a + 1;
                } else {
                    set<T>(dst, k, get<T>(src, b));
                    b = b + 1;
                }
                k = k + 1;
            }
            lo = hi;
        }
        let t = src;
        src = dst;
        dst = t;
        in_v = !in_v;
        width = width * 2;
    }
    if (!in_v) {
        // the result is in the scratch Vec: copy it back into v
        i = 0;
        while (i < n) {
            set<T>(v, i, get<T>(src, i));
            i = i + 1;
        }
    }
    return v;
}
