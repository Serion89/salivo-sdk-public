// Salivo Standard Library: Compression (DEFLATE RFC 1951, zlib RFC 1950, gzip RFC 1952)
module salivo.std.compress;
><salivo.std.core::{Result, ok, err};
><salivo.std.collections::{Vec, vecNew, vecCap, push, get, veclen};
><salivo.std.text::{byteAtUnchecked};

/// Container formats for compress / decompress
pub const RAW = 0;
pub const ZLIB = 1;
pub const GZIP = 2;
/// decompress only: recognise gzip, zlib or raw DEFLATE from the first bytes
pub const AUTO = 3;

/// Bytes (each element 0..255) compressed into format (RAW, ZLIB or GZIP); level 0 stores, 1-9 compress
pub func compress(data: Vec<int>, format: int, level: int) -> Vec<int> {
    let n = veclen<int>(data);
    let src = czToBuffer(data);
    let cap = rtdeflatebound(n) + 32;
    let dst = rtalloc(cap, 8);
    let m = rtdeflate(src, n, dst, cap, format, level);
    let out = czFromBuffer(dst, m);
    rtdeallocate(src, n + 1, 8);
    rtdeallocate(dst, cap, 8);
    return out;
}

/// Decompresses format (RAW, ZLIB, GZIP or AUTO); Err for malformed or corrupted data (checksums are verified)
/// or output beyond maxBytes
pub func decompress(data: Vec<int>, format: int, maxBytes: int) -> Result<Vec<int>, string> {
    let n = veclen<int>(data);
    let src = czToBuffer(data);
    // grow the output buffer until it fits (the format does not record the size up front)
    let mut cap = n * 4 + 1024;
    if (cap > maxBytes) { cap = maxBytes; }
    let mut result = err<Vec<int>, string>("decompressed data larger than the limit");
    let mut done = false;
    while (!done) {
        let size = cap;
        let dst = rtalloc(size + 1, 8);
        let m = rtinflate(src, n, dst, size, format);
        if (m >= 0) {
            result = ok<Vec<int>, string>(czFromBuffer(dst, m));
            done = true;
        } else if (m == 0 - 2 && size < maxBytes) {
            cap = size * 2;
            if (cap > maxBytes) { cap = maxBytes; }
        } else {
            if (m == 0 - 1) { result = err<Vec<int>, string>("malformed or corrupted compressed data"); }
            done = true;
        }
        rtdeallocate(dst, size + 1, 8);
    }
    rtdeallocate(src, n + 1, 8);
    return result;
}

/// gzip of a text's bytes
pub func gzipText(s: string, level: int) -> Vec<int> {
    return compress(textBytes(s), GZIP, level);
}

/// Text from gzip (or zlib / raw, detected) data; Err when it does not decode or holds a 0 byte
pub func gunzipText(data: Vec<int>, maxBytes: int) -> Result<string, string> {
    let r = decompress(data, AUTO, maxBytes);
    if (!r.is_ok) { return err<string, string>(r.error); }
    let v = r.value;
    let n = veclen<int>(v);
    let buf = rtalloc(n + 1, 8);
    for (let mut i = 0; i < n; i = i + 1) {
        let b = get<int>(v, i);
        if (b == 0) {
            rtdeallocate(buf, n + 1, 8);
            return err<string, string>("decompressed data contains a 0 byte (not text)");
        }
        rtmemwritebyte(buf, i, b);
    }
    let s = rtbufstr(buf, n);
    rtdeallocate(buf, n + 1, 8);
    return ok<string, string>(s);
}

/// The bytes of a text
pub func textBytes(s: string) -> Vec<int> {
    let n = len(s);
    let mut v = vecCap<int>(n);
    for (let mut i = 0; i < n; i = i + 1) { v = push<int>(v, byteAtUnchecked(s, i)); }
    return v;
}

/// CRC-32 (gzip / PNG / zip polynomial) of bytes
pub func crc32(data: Vec<int>) -> int {
    let n = veclen<int>(data);
    let src = czToBuffer(data);
    let c = rtcrc32(src, n);
    rtdeallocate(src, n + 1, 8);
    return c;
}

/// Adler-32 (zlib) of bytes
pub func adler32(data: Vec<int>) -> int {
    let n = veclen<int>(data);
    let src = czToBuffer(data);
    let c = rtadler32(src, n);
    rtdeallocate(src, n + 1, 8);
    return c;
}

func czToBuffer(data: Vec<int>) -> int {
    let n = veclen<int>(data);
    let buf = rtalloc(n + 1, 8);
    for (let mut i = 0; i < n; i = i + 1) { rtmemwritebyte(buf, i, get<int>(data, i)); }
    return buf;
}

func czFromBuffer(buf: int, n: int) -> Vec<int> {
    let mut v = vecNew<int>();
    if (n <= 0) { return v; }
    v = vecCap<int>(n);
    for (let mut i = 0; i < n; i = i + 1) { v = push<int>(v, rtmemreadbyte(buf, i)); }
    return v;
}
