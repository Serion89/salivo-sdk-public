// Salivo Standard Library: Hash Module
module salivo.std.hash;
><salivo.std.strings::{len, charat};

/// Computes a 64-bit deterministic hash of raw memory bytes using FNV-1a.
/// Authoritative over exact byte length, preserving embedded NUL bytes.
pub func hashBytes(int addr, int length) -> int {
    if (addr == 0 || length <= 0) {
        return 0;
    }
    return rthashbytes(addr, length);
}

/// Hashes a string using its exact buffer pointer and authoritative byte length.
pub func hashStr(string s) -> int {
    let slen = s.len;
    if (slen <= 0) {
        return 0;
    }
    return hashBytes(s.ptr, slen);
}

/// Backwards-compatible alias for hashStr
pub func hashstr(string s) -> int {
    return hashStr(s);
}

/// High-entropy 64-bit integer hash (SplitMix64 / Murmur finalizer)
pub func hashInt(int v) -> int {
    let mut z = v + 11400714819323198485;
    z = (z ^ (z >> 30)) * 13787848793156544541;
    z = (z ^ (z >> 27)) * 10723151780598845931;
    let mut h = z ^ (z >> 31);
    if (h < 0) {
        h = 0 - h;
    }
    return h;
}

/// Backwards-compatible alias for hashInt
pub func hash(int v) -> int {
    return hashInt(v);
}

/// Hashes a boolean value
pub func hashBool(bool b) -> int {
    if (b) {
        return 1;
    }
    return 0;
}
