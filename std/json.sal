// Salivo Standard Library: JSON Module
// Read: jsonParse validates text once and returns a Json view; jsonGet / jsonAt / jsonPath walk it
// without copying, and jsonStr / jsonInt / jsonFloat / jsonBool / jsonKeys read values out.
// Write: values are JSON text. jsonString / jsonInt... make scalars; jsonSet adds or replaces an
// object member, jsonPush appends to an array, jsonPretty re-indents.
//   let doc = jsonParse("{\"user\": {\"name\": \"Ada\", \"tags\": [\"x\", \"y\"]}}").value;
//   jsonStr(jsonPath(doc, "user.tags[1]"))                 // "y"
//   let out = jsonSet("{}", "id", jsonIntText(7));        // {"id":7}
module salivo.std.json;

><salivo.std.core::{Result, ok, err};
><salivo.std.collections::{Vec, vecNew, push, get, veclen};
><salivo.std.text::{byteAt, isDigit};
><salivo.std.encoding::{bytesToText};

pub const JSON_MISSING = 0;
pub const JSON_NULL = 1;
pub const JSON_BOOL = 2;
pub const JSON_NUMBER = 3;
pub const JSON_STRING = 4;
pub const JSON_ARRAY = 5;
pub const JSON_OBJECT = 6;

/// A value inside JSON text: text[start..end] (kind JSON_MISSING when a lookup found nothing)
pub struct Json {
    string text;
    int start;
    int end;
    int kind;
}

func skipWs(t: string, i0: int) -> int {
    let n = len(t);
    let mut i = i0;
    while (i < n) {
        let c = byteAt(t, i);
        if (c != 32 && c != 9 && c != 10 && c != 13) { return i; }
        i = i + 1;
    }
    return i;
}

func hexVal(c: int) -> int {
    if (c >= 48 && c <= 57) { return c - 48; }
    if (c >= 97 && c <= 102) { return c - 87; }
    if (c >= 65 && c <= 70) { return c - 55; }
    return 0 - 1;
}

/// End of the string starting at the quote at i (index after the closing quote), -1 if malformed
func scanString(t: string, i0: int) -> int {
    let n = len(t);
    let mut i = i0 + 1;
    while (i < n) {
        let c = byteAt(t, i);
        if (c == 34) { return i + 1; }
        if (c < 32) { return 0 - 1; }
        if (c == 92) {
            if (i + 1 >= n) { return 0 - 1; }
            let e = byteAt(t, i + 1);
            if (e == 117) {
                if (i + 5 >= n) { return 0 - 1; }
                let mut k = 2;
                while (k < 6) {
                    if (hexVal(byteAt(t, i + k)) < 0) { return 0 - 1; }
                    k = k + 1;
                }
                i = i + 6;
            } else if (e == 34 || e == 92 || e == 47 || e == 98 || e == 102 || e == 110 || e == 114 || e == 116) {
                i = i + 2;
            } else {
                return 0 - 1;
            }
        } else {
            i = i + 1;
        }
    }
    return 0 - 1;
}

func scanNumber(t: string, i0: int) -> int {
    let n = len(t);
    let mut i = i0;
    if (i < n && byteAt(t, i) == 45) { i = i + 1; }
    if (i >= n || !isDigit(byteAt(t, i))) { return 0 - 1; }
    if (byteAt(t, i) == 48) {
        i = i + 1;
    } else {
        while (i < n && isDigit(byteAt(t, i))) { i = i + 1; }
    }
    if (i < n && byteAt(t, i) == 46) {
        i = i + 1;
        if (i >= n || !isDigit(byteAt(t, i))) { return 0 - 1; }
        while (i < n && isDigit(byteAt(t, i))) { i = i + 1; }
    }
    if (i < n && (byteAt(t, i) == 101 || byteAt(t, i) == 69)) {
        i = i + 1;
        if (i < n && (byteAt(t, i) == 43 || byteAt(t, i) == 45)) { i = i + 1; }
        if (i >= n || !isDigit(byteAt(t, i))) { return 0 - 1; }
        while (i < n && isDigit(byteAt(t, i))) { i = i + 1; }
    }
    return i;
}

func scanWord(t: string, i: int, w: string) -> int {
    if (slice(t, i, i + len(w)) == w) { return i + len(w); }
    return 0 - 1;
}

/// End index of the value starting at i (after whitespace), or -1; depth guards deep nesting
func scanValue(t: string, i0: int, depth: int) -> int {
    if (depth > 512) { return 0 - 1; }
    let n = len(t);
    let i = skipWs(t, i0);
    if (i >= n) { return 0 - 1; }
    let c = byteAt(t, i);
    if (c == 34) { return scanString(t, i); }
    if (c == 123 || c == 91) {
        let close = c + 2;
        let mut j = skipWs(t, i + 1);
        if (j < n && byteAt(t, j) == close) { return j + 1; }
        while (true) {
            if (c == 123) {
                j = skipWs(t, j);
                if (j >= n || byteAt(t, j) != 34) { return 0 - 1; }
                j = scanString(t, j);
                if (j < 0) { return 0 - 1; }
                j = skipWs(t, j);
                if (j >= n || byteAt(t, j) != 58) { return 0 - 1; }
                j = j + 1;
            }
            j = scanValue(t, j, depth + 1);
            if (j < 0) { return 0 - 1; }
            j = skipWs(t, j);
            if (j >= n) { return 0 - 1; }
            if (byteAt(t, j) == close) { return j + 1; }
            if (byteAt(t, j) != 44) { return 0 - 1; }
            j = j + 1;
        }
    }
    if (c == 116) { return scanWord(t, i, "true"); }
    if (c == 102) { return scanWord(t, i, "false"); }
    if (c == 110) { return scanWord(t, i, "null"); }
    return scanNumber(t, i);
}

func kindAt(t: string, i: int) -> int {
    let c = byteAt(t, i);
    if (c == 123) { return JSON_OBJECT; }
    if (c == 91) { return JSON_ARRAY; }
    if (c == 34) { return JSON_STRING; }
    if (c == 116 || c == 102) { return JSON_BOOL; }
    if (c == 110) { return JSON_NULL; }
    return JSON_NUMBER;
}

func view(t: string, start: int, end: int) -> Json {
    return Json { text: t, start: start, end: end, kind: kindAt(t, start) };
}

func missing(t: string) -> Json {
    return Json { text: t, start: 0, end: 0, kind: JSON_MISSING };
}

/// Validates text (RFC 8259) and returns a view of its top-level value
pub func jsonParse(text: string) -> Result<Json, string> {
    let start = skipWs(text, 0);
    let end = scanValue(text, 0, 0);
    if (end < 0) { return err<Json, string>("invalid JSON"); }
    if (skipWs(text, end) != len(text)) { return err<Json, string>("unexpected text after the JSON value at " + intstr(skipWs(text, end))); }
    return ok<Json, string>(view(text, start, end));
}

/// True when text is valid JSON
pub func jsonValid(text: string) -> bool { return jsonParse(text).is_ok; }

pub func jsonKind(j: Json) -> int { return j.kind; }
pub func jsonExists(j: Json) -> bool { return j.kind != JSON_MISSING; }
pub func jsonIsNull(j: Json) -> bool { return j.kind == JSON_NULL; }

/// The value's JSON text ("" when missing)
pub func jsonRaw(j: Json) -> string {
    if (j.kind == JSON_MISSING) { return ""; }
    return slice(j.text, j.start, j.end);
}

/// Member `key` of an object (missing when absent or j is not an object)
pub func jsonGet(j: Json, key: string) -> Json {
    if (j.kind != JSON_OBJECT) { return missing(j.text); }
    let t = j.text;
    let mut i = skipWs(t, j.start + 1);
    if (byteAt(t, i) == 125) { return missing(t); }
    while (i < j.end) {
        let kend = scanString(t, i);
        let k = decodeString(t, i, kend);
        let vstart = skipWs(t, skipWs(t, kend) + 1);
        let vend = scanValue(t, vstart, 0);
        if (k == key) { return view(t, vstart, vend); }
        i = skipWs(t, vend);
        if (byteAt(t, i) != 44) { return missing(t); }
        i = skipWs(t, i + 1);
    }
    return missing(t);
}

/// True when the object has member key
pub func jsonHas(j: Json, key: string) -> bool { return jsonGet(j, key).kind != JSON_MISSING; }

/// Element `index` of an array (missing when out of range)
pub func jsonAt(j: Json, index: int) -> Json {
    if (j.kind != JSON_ARRAY || index < 0) { return missing(j.text); }
    let t = j.text;
    let mut i = skipWs(t, j.start + 1);
    if (byteAt(t, i) == 93) { return missing(t); }
    let mut k = 0;
    while (i < j.end) {
        let vend = scanValue(t, i, 0);
        if (k == index) { return view(t, i, vend); }
        i = skipWs(t, vend);
        if (byteAt(t, i) != 44) { return missing(t); }
        i = skipWs(t, i + 1);
        k = k + 1;
    }
    return missing(t);
}

/// Number of elements of an array or members of an object (0 otherwise)
pub func jsonLen(j: Json) -> int {
    if (j.kind != JSON_ARRAY && j.kind != JSON_OBJECT) { return 0; }
    let t = j.text;
    let mut i = skipWs(t, j.start + 1);
    if (i < j.end && (byteAt(t, i) == 93 || byteAt(t, i) == 125)) { return 0; }
    let mut count = 0;
    while (i < j.end) {
        if (j.kind == JSON_OBJECT) { i = skipWs(t, skipWs(t, scanString(t, i)) + 1); }
        i = skipWs(t, scanValue(t, i, 0));
        count = count + 1;
        if (byteAt(t, i) != 44) { return count; }
        i = skipWs(t, i + 1);
    }
    return count;
}

/// Member names of an object in document order
pub func jsonKeys(j: Json) -> Vec<string> {
    let mut out = vecNew<string>();
    if (j.kind != JSON_OBJECT) { return out; }
    let t = j.text;
    let mut i = skipWs(t, j.start + 1);
    if (byteAt(t, i) == 125) { return out; }
    while (i < j.end) {
        let kend = scanString(t, i);
        out = push<string>(out, decodeString(t, i, kend));
        i = skipWs(t, scanValue(t, skipWs(t, kend) + 1, 0));
        if (byteAt(t, i) != 44) { return out; }
        i = skipWs(t, i + 1);
    }
    return out;
}

/// Follows a path like "user.tags[1].name" or "[0].id" (missing when any step is absent)
pub func jsonPath(j: Json, path: string) -> Json {
    let mut cur = j;
    let n = len(path);
    let mut i = 0;
    while (i < n) {
        let c = byteAt(path, i);
        if (c == 46) {
            i = i + 1;
        } else if (c == 91) {
            let mut k = i + 1;
            let mut idx = 0;
            while (k < n && isDigit(byteAt(path, k))) {
                idx = idx * 10 + byteAt(path, k) - 48;
                k = k + 1;
            }
            if (k >= n || byteAt(path, k) != 93) { return missing(j.text); }
            cur = jsonAt(cur, idx);
            i = k + 1;
        } else {
            let mut k = i;
            while (k < n && byteAt(path, k) != 46 && byteAt(path, k) != 91) { k = k + 1; }
            cur = jsonGet(cur, slice(path, i, k));
            i = k;
        }
        if (cur.kind == JSON_MISSING) { return cur; }
    }
    return cur;
}

func utf8Push(out: Vec<int>, cp: int) -> Vec<int> {
    let mut o = out;
    if (cp < 128) {
        o = push<int>(o, cp);
    } else if (cp < 2048) {
        o = push<int>(o, 192 + cp / 64);
        o = push<int>(o, 128 + cp % 64);
    } else if (cp < 65536) {
        o = push<int>(o, 224 + cp / 4096);
        o = push<int>(o, 128 + (cp / 64) % 64);
        o = push<int>(o, 128 + cp % 64);
    } else {
        o = push<int>(o, 240 + cp / 262144);
        o = push<int>(o, 128 + (cp / 4096) % 64);
        o = push<int>(o, 128 + (cp / 64) % 64);
        o = push<int>(o, 128 + cp % 64);
    }
    return o;
}

func hex4(t: string, i: int) -> int {
    return hexVal(byteAt(t, i)) * 4096 + hexVal(byteAt(t, i + 1)) * 256 + hexVal(byteAt(t, i + 2)) * 16 + hexVal(byteAt(t, i + 3));
}

/// Unescaped contents of the (valid) string token t[start..end]
func decodeString(t: string, start: int, end: int) -> string {
    let mut has_escape = false;
    let mut i = start + 1;
    while (i < end - 1) {
        if (byteAt(t, i) == 92) { has_escape = true; }
        i = i + 1;
    }
    if (!has_escape) { return slice(t, start + 1, end - 1); }
    let mut out = vecNew<int>();
    i = start + 1;
    while (i < end - 1) {
        let c = byteAt(t, i);
        if (c != 92) {
            out = push<int>(out, c);
            i = i + 1;
        } else {
            let e = byteAt(t, i + 1);
            if (e == 117) {
                let mut cp = hex4(t, i + 2);
                i = i + 6;
                // a surrogate pair encodes one code point above U+FFFF
                if (cp >= 55296 && cp <= 56319 && i + 5 < end && byteAt(t, i) == 92 && byteAt(t, i + 1) == 117) {
                    let lo = hex4(t, i + 2);
                    if (lo >= 56320 && lo <= 57343) {
                        cp = 65536 + (cp - 55296) * 1024 + (lo - 56320);
                        i = i + 6;
                    }
                }
                if (cp == 0) { cp = 65533; }
                out = utf8Push(out, cp);
            } else {
                if (e == 110) { out = push<int>(out, 10); }
                else if (e == 116) { out = push<int>(out, 9); }
                else if (e == 114) { out = push<int>(out, 13); }
                else if (e == 98) { out = push<int>(out, 8); }
                else if (e == 102) { out = push<int>(out, 12); }
                else { out = push<int>(out, e); }
                i = i + 2;
            }
        }
    }
    let r = bytesToText(out);
    if (r.is_ok) { return r.value; }
    return "";
}

/// String value (unescaped); for other kinds their JSON text, "" when missing
pub func jsonStr(j: Json) -> string {
    if (j.kind == JSON_STRING) { return decodeString(j.text, j.start, j.end); }
    return jsonRaw(j);
}

/// Integer value of a number (fraction dropped); fallback for other kinds
pub func jsonIntOr(j: Json, fallback: int) -> int {
    if (j.kind != JSON_NUMBER) { return fallback; }
    let raw = jsonRaw(j);
    let mut k = 0;
    while (k < len(raw) && byteAt(raw, k) != 46 && byteAt(raw, k) != 101 && byteAt(raw, k) != 69) { k = k + 1; }
    if (k == len(raw)) { return strint(raw); }
    return rtfloattoint(strfloat(raw));
}

pub func jsonInt(j: Json) -> int { return jsonIntOr(j, 0); }

pub func jsonFloatOr(j: Json, fallback: float) -> float {
    if (j.kind != JSON_NUMBER) { return fallback; }
    return strfloat(jsonRaw(j));
}

pub func jsonFloat(j: Json) -> float { return jsonFloatOr(j, 0.0); }

/// true only for the literal true
pub func jsonBool(j: Json) -> bool {
    return j.kind == JSON_BOOL && byteAt(j.text, j.start) == 116;
}

/// Array elements as views
pub func jsonItems(j: Json) -> Vec<Json> {
    let mut out = vecNew<Json>();
    if (j.kind != JSON_ARRAY) { return out; }
    let t = j.text;
    let mut i = skipWs(t, j.start + 1);
    if (byteAt(t, i) == 93) { return out; }
    while (i < j.end) {
        let vend = scanValue(t, i, 0);
        out = push<Json>(out, view(t, i, vend));
        i = skipWs(t, vend);
        if (byteAt(t, i) != 44) { return out; }
        i = skipWs(t, i + 1);
    }
    return out;
}

// ------------------------------------------------------------------------------------------
// Writing
// ------------------------------------------------------------------------------------------

/// s as a JSON string literal, quotes included
pub func jsonString(s: string) -> string {
    let digits = "0123456789abcdef";
    let n = len(s);
    let mut out = "\"";
    let mut start = 0;
    let mut i = 0;
    while (i < n) {
        let c = byteAt(s, i);
        if (c == 34 || c == 92 || c < 32) {
            out = out + slice(s, start, i);
            if (c == 34) { out = out + "\\\""; }
            else if (c == 92) { out = out + "\\\\"; }
            else if (c == 10) { out = out + "\\n"; }
            else if (c == 13) { out = out + "\\r"; }
            else if (c == 9) { out = out + "\\t"; }
            else { out = out + "\\u00" + slice(digits, c / 16, c / 16 + 1) + slice(digits, c % 16, c % 16 + 1); }
            start = i + 1;
        }
        i = i + 1;
    }
    return out + slice(s, start, n) + "\"";
}

pub func jsonIntText(v: int) -> string { return intstr(v); }
pub func jsonFloatText(v: float) -> string { return floatstr(v); }

pub func jsonBoolText(b: bool) -> string {
    if (b) { return "true"; }
    return "false";
}

/// ["a","b"] from strings
pub func jsonStringArray(items: Vec<string>) -> string {
    let mut out = "[";
    let n = veclen<string>(items);
    let mut i = 0;
    while (i < n) {
        if (i > 0) { out = out + ","; }
        out = out + jsonString(get<string>(items, i));
        i = i + 1;
    }
    return out + "]";
}

/// Array from values that are already JSON text
pub func jsonArray(rawItems: Vec<string>) -> string {
    let mut out = "[";
    let n = veclen<string>(rawItems);
    let mut i = 0;
    while (i < n) {
        if (i > 0) { out = out + ","; }
        out = out + get<string>(rawItems, i);
        i = i + 1;
    }
    return out + "]";
}

/// obj (JSON object text) with member key set to rawValue (JSON text); replaces an existing member.
/// Panics when obj is not a JSON object or rawValue is not valid JSON.
pub func jsonSet(obj: string, key: string, rawValue: string) -> string {
    let p = jsonParse(obj);
    if (!p.is_ok || p.value.kind != JSON_OBJECT) { panic("jsonSet: not a JSON object"); }
    if (!jsonValid(rawValue)) { panic("jsonSet: value for '" + key + "' is not valid JSON: " + rawValue); }
    let o = p.value;
    let member = jsonString(key) + ":" + trim(rawValue);
    let existing = jsonGet(o, key);
    if (existing.kind != JSON_MISSING) {
        return slice(obj, 0, existing.start) + trim(rawValue) + slice(obj, existing.end, len(obj));
    }
    let close = o.end - 1;
    if (jsonLen(o) == 0) { return slice(obj, 0, o.start + 1) + member + slice(obj, close, len(obj)); }
    return slice(obj, 0, close) + "," + member + slice(obj, close, len(obj));
}

/// arr (JSON array text) with rawValue appended
pub func jsonPush(arr: string, rawValue: string) -> string {
    let p = jsonParse(arr);
    if (!p.is_ok || p.value.kind != JSON_ARRAY) { panic("jsonPush: not a JSON array"); }
    if (!jsonValid(rawValue)) { panic("jsonPush: value is not valid JSON: " + rawValue); }
    let a = p.value;
    let close = a.end - 1;
    if (jsonLen(a) == 0) { return slice(arr, 0, a.start + 1) + trim(rawValue) + slice(arr, close, len(arr)); }
    return slice(arr, 0, close) + "," + trim(rawValue) + slice(arr, close, len(arr));
}

/// Compact form (insignificant whitespace removed)
pub func jsonMinify(text: string) -> string { return jsonPretty(text, 0 - 1); }

/// Re-indented with `indent` spaces per level (indent < 0: compact on one line)
pub func jsonPretty(text: string, indent: int) -> string {
    let n = len(text);
    let mut out = "";
    let mut level = 0;
    let mut i = 0;
    while (i < n) {
        let c = byteAt(text, i);
        if (c == 34) {
            let e = scanString(text, i);
            if (e < 0) { return text; }
            out = out + slice(text, i, e);
            i = e;
        } else if (c == 32 || c == 9 || c == 10 || c == 13) {
            i = i + 1;
        } else if (c == 123 || c == 91) {
            let after = skipWs(text, i + 1);
            if (after < n && byteAt(text, after) == c + 2) {
                out = out + slice(text, i, i + 1) + slice(text, after, after + 1);
                i = after + 1;
            } else {
                level = level + 1;
                out = out + slice(text, i, i + 1);
                if (indent >= 0) { out = out + "\n" + repeat(" ", level * indent); }
                i = i + 1;
            }
        } else if (c == 125 || c == 93) {
            level = level - 1;
            if (indent >= 0) { out = out + "\n" + repeat(" ", level * indent); }
            out = out + slice(text, i, i + 1);
            i = i + 1;
        } else if (c == 44) {
            out = out + ",";
            if (indent >= 0) { out = out + "\n" + repeat(" ", level * indent); }
            i = i + 1;
        } else if (c == 58) {
            out = out + ":";
            if (indent >= 0) { out = out + " "; }
            i = i + 1;
        } else {
            let start = i;
            while (i < n && byteAt(text, i) != 44 && byteAt(text, i) != 125 && byteAt(text, i) != 93 && byteAt(text, i) != 32 && byteAt(text, i) != 10 && byteAt(text, i) != 13 && byteAt(text, i) != 9) { i = i + 1; }
            out = out + slice(text, start, i);
        }
    }
    return out;
}
