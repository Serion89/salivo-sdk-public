{
  "Main Function": {
    "prefix": "main",
    "body": [
      "module main;",
      "",
      "><salivo.std.core::{outln};",
      "",
      "func main() -> int {",
      "    ${0:outln(\"Hello, Salivo!\");}",
      "    return 0;",
      "}"
    ],
    "description": "Standard main module and entry point"
  },
  "Function Declaration": {
    "prefix": "func",
    "body": [
      "func ${1:name}(${2:params}) -> ${3:int} {",
      "    ${0}",
      "    return 0;",
      "}"
    ],
    "description": "Define a new function"
  },
  "Public Function Declaration": {
    "prefix": "pubfunc",
    "body": [
      "pub func ${1:name}(${2:params}) -> ${3:int} {",
      "    ${0}",
      "    return 0;",
      "}"
    ],
    "description": "Define a new public function"
  },
  "Unit Test Function": {
    "prefix": "test",
    "body": [
      "pub func test_${1:feature}() -> int {",
      "    assertEq(${2:actual}, ${3:expected});",
      "    return 0;",
      "}"
    ],
    "description": "Define a unit test function with assertEq"
  },
  "Struct Definition": {
    "prefix": "struct",
    "body": [
      "struct ${1:Name} {",
      "    ${2:field}: ${3:string},",
      "}"
    ],
    "description": "Define a new PascalCase struct"
  },
  "Public Struct Definition": {
    "prefix": "pubstruct",
    "body": [
      "pub struct ${1:Name} {",
      "    ${2:field}: ${3:string},",
      "}"
    ],
    "description": "Define a new public PascalCase struct"
  },
  "Enum Definition": {
    "prefix": "enum",
    "body": [
      "enum ${1:Name} {",
      "    ${2:Variant1},",
      "    ${3:Variant2},",
      "}"
    ],
    "description": "Define a new PascalCase enum"
  },
  "Public Enum Definition": {
    "prefix": "pubenum",
    "body": [
      "pub enum ${1:Name} {",
      "    ${2:Variant1},",
      "    ${3:Variant2},",
      "}"
    ],
    "description": "Define a new public PascalCase enum"
  },
  "Trait Definition": {
    "prefix": "trait",
    "body": [
      "pub trait ${1:Name} {",
      "    func ${2:method}(self) -> ${3:void};",
      "}"
    ],
    "description": "Define a new trait interface"
  },
  "Trait Implementation": {
    "prefix": "impl",
    "body": [
      "impl ${1:TraitName} for ${2:TypeName} {",
      "    func ${3:method}(self) -> ${4:void} {",
      "        ${0}",
      "    }",
      "}"
    ],
    "description": "Implement a trait for a struct"
  },
  "Drop Trait Implementation": {
    "prefix": "drop",
    "body": [
      "impl Drop for ${1:TypeName} {",
      "    func drop(self) {",
      "        ${0:// Deterministic RAII cleanup logic}",
      "    }",
      "}"
    ],
    "description": "Implement RAII Drop trait for deterministic resource cleanup"
  },
  "Try Error Propagation (?)": {
    "prefix": "try",
    "body": [
      "let ${1:value} = ${2:fallible_expr}?;"
    ],
    "description": "Unwrap Result/Option or return early using postfix ?"
  },
  "For Loop (3-Clause)": {
    "prefix": "for",
    "body": [
      "for (let mut ${1:i} = 0; ${1:i} < ${2:10}; ${1:i} = ${1:i} + 1) {",
      "    ${0}",
      "}"
    ],
    "description": "3-clause C-style for loop"
  },
  "While Loop": {
    "prefix": "while",
    "body": [
      "while (${1:condition}) {",
      "    ${0}",
      "}"
    ],
    "description": "While loop"
  },
  "If Statement": {
    "prefix": "if",
    "body": [
      "if (${1:condition}) {",
      "    ${0}",
      "}"
    ],
    "description": "If condition block"
  },
  "If Else Statement": {
    "prefix": "ifelse",
    "body": [
      "if (${1:condition}) {",
      "    ${2}",
      "} else {",
      "    ${0}",
      "}"
    ],
    "description": "If / Else condition block"
  },
  "Match Statement": {
    "prefix": "match",
    "body": [
      "match ${1:value} {",
      "    ${2:0} => ${3:expression},",
      "    _ => ${0:default_expression},",
      "}"
    ],
    "description": "Pattern matching match statement"
  },
  "Stream Header Import Core": {
    "prefix": "importcore",
    "body": [
      "><salivo.std.core::{${1:assert, assertEq, Option, Result, some, none, ok, err, Drop}};"
    ],
    "description": "Stream import for salivo.std.core"
  },
  "Stream Header Import FS": {
    "prefix": "importfs",
    "body": [
      "><salivo.std.fs::{${1:pathJoin, pathExists, open, close, readByte}};"
    ],
    "description": "Stream import for salivo.std.fs"
  },
  "Stream Header Import IO": {
    "prefix": "importio",
    "body": [
      "><salivo.std.io::{${1:readStr, writeStr, print, println}};"
    ],
    "description": "Stream import for salivo.std.io"
  },
  "Stream Header Import Collections": {
    "prefix": "importcoll",
    "body": [
      "><salivo.std.collections::{${1:vecNew, push, pop, get, mapNew, put, lookup}};"
    ],
    "description": "Stream import for salivo.std.collections"
  },
  "Stream Header Import Crypto": {
    "prefix": "importcrypto",
    "body": [
      "><salivo.std.crypto::{${1:sha256Hex, secSeed, randBytes}};"
    ],
    "description": "Stream import for salivo.std.crypto"
  },
  "Stream Header Import Strings": {
    "prefix": "importstrings",
    "body": [
      "><salivo.std.strings::{${1:stringNew, pushStr, asStr, fromStr}};"
    ],
    "description": "Stream import for salivo.std.strings"
  },
  "Stream Header Import Net": {
    "prefix": "importnet",
    "body": [
      "><salivo.std.net::{${1:ipv4, sockaddr, parseip, tcpsendstr, tcprecvstr, TcpStream}};"
    ],
    "description": "Stream import for salivo.std.net"
  },
  "Stream Header Import Generic": {
    "prefix": "import",
    "body": [
      "><${1:salivo.std.core::{assert, assertEq}};"
    ],
    "description": "Canonical stream import using >< syntax"
  },
  "Dynamic Vector": {
    "prefix": "vec",
    "body": [
      "let mut ${1:numbers} = vecNew<${2:int}>();"
    ],
    "description": "Initialize a new dynamic vector"
  },
  "Vector Push": {
    "prefix": "vecpush",
    "body": [
      "${1:numbers} = push<${2:int}>(${1:numbers}, ${3:value});"
    ],
    "description": "Append value to vector"
  },
  "Vector Insert": {
    "prefix": "vecinsert",
    "body": [
      "${1:numbers} = insert<${2:int}>(${1:numbers}, ${3:index}, ${4:value});"
    ],
    "description": "Insert value at index in vector"
  },
  "Vector Remove": {
    "prefix": "vecremove",
    "body": [
      "${1:numbers} = remove<${2:int}>(${1:numbers}, ${3:index});"
    ],
    "description": "Remove element at index in vector"
  },
  "Hash Map": {
    "prefix": "map",
    "body": [
      "let mut ${1:map} = mapNew<${2:string}, ${3:int}>();"
    ],
    "description": "Initialize a new hash map"
  },
  "Map Put": {
    "prefix": "mapput",
    "body": [
      "${1:map} = put<${2:string}, ${3:int}>(${1:map}, ${4:key}, ${5:value});"
    ],
    "description": "Insert or update key-value pair in map"
  },
  "Map Lookup": {
    "prefix": "mapget",
    "body": [
      "let ${1:opt} = lookup<${2:string}, ${3:int}>(${4:map}, ${5:key});"
    ],
    "description": "Lookup key in map returning Option"
  },
  "Owned String": {
    "prefix": "stringnew",
    "body": [
      "let mut ${1:s} = stringNew();",
      "pushStr(${1:s}, \"${2:initial}\");"
    ],
    "description": "Initialize a new heap String with pushStr"
  },
  "Input Integer": {
    "prefix": "in:int",
    "body": [
      "let ${1:value} = in():int;"
    ],
    "description": "Read line from console and convert to integer"
  },
  "Input Float": {
    "prefix": "in:float",
    "body": [
      "let ${1:value} = in():float;"
    ],
    "description": "Read line from console and convert to float"
  },
  "Input String": {
    "prefix": "in:str",
    "body": [
      "let ${1:text} = in():trim;"
    ],
    "description": "Read line from console and trim whitespace"
  },
  "Interactive Input": {
    "prefix": "input",
    "body": [
      "let ${1:text} = input();"
    ],
    "description": "Read line from standard input"
  },
  "Environment Lookup": {
    "prefix": "env",
    "body": [
      "let ${1:val} = env(\"${2:KEY}\", \"${3:default}\");"
    ],
    "description": "Lookup environment variable with fallback"
  },
  "Print Line": {
    "prefix": "outln",
    "body": [
      "outln(\"${1:message}\");"
    ],
    "description": "Print line to standard output"
  },
  "Formatted Print Line": {
    "prefix": "outln$",
    "body": [
      "outln($\"${1:Value}: {${2:variable}}\");"
    ],
    "description": "Print interpolated formatted string to standard output"
  },
  "Assert Equal (camelCase)": {
    "prefix": "assertEq",
    "body": [
      "assertEq(${1:actual}, ${2:expected});"
    ],
    "description": "Assert two values are equal (modern camelCase standard)"
  },
  "Assert String Equal": {
    "prefix": "assertStrEq",
    "body": [
      "assertStrEq(${1:actual}, ${2:expected});"
    ],
    "description": "Assert two string values are equal"
  },
  "Path Join": {
    "prefix": "pathjoin",
    "body": [
      "let ${1:fullPath} = pathJoin(\"${2:dir}\", \"${3:file}\");"
    ],
    "description": "Join filesystem paths using canonical pathJoin"
  },
  "SQLite Query": {
    "prefix": "sqlite",
    "body": [
      "><salivosqlite;",
      "",
      "let conn = salivosqlite.openmem()?;",
      "let _ = salivosqlite.execute(conn, \"${1:CREATE TABLE IF NOT EXISTS items (id INTEGER PRIMARY KEY, name TEXT);}\");",
      "salivosqlite.closeconn(conn);"
    ],
    "description": "Open and execute SQLite query with clean salivosqlite API"
  },
  "Web HTTP Router": {
    "prefix": "webrouter",
    "body": [
      "><salivoweb;",
      "",
      "let mut router = salivoweb.router();",
      "router = salivoweb.get(router, \"/api/health\", \"{\\\"status\\\": \\\"healthy\\\"}\");",
      "salivoweb.listen(router, ${1:8080});"
    ],
    "description": "Create a Salivo Web HTTP router and listen on port"
  }
}
