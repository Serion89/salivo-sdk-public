{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Salivo",
  "scopeName": "source.salivo",
  "patterns": [
    { "include": "#comments" },
    { "include": "#imports" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#modifiers" },
    { "include": "#builtins" },
    { "include": "#functions" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.salivo",
          "match": "///.*$"
        },
        {
          "name": "comment.line.double-slash.salivo",
          "match": "//.*$"
        },
        {
          "name": "comment.block.salivo",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "imports": {
      "patterns": [
        {
          "match": "(><)\\s*([a-zA-Z0-9_.]+)(?:::(\\{[^}]*\\}))?;?",
          "captures": {
            "1": { "name": "keyword.operator.import.salivo" },
            "2": { "name": "entity.name.namespace.salivo" },
            "3": { "name": "variable.other.member.salivo" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.salivo",
          "match": "\\b(if|else|match|while|for|in|loop|break|continue|return|yield|await|async|spawn)\\b"
        },
        {
          "name": "keyword.declaration.salivo",
          "match": "\\b(module|func|let|mut|struct|enum|trait|impl|type|pub|const)\\b"
        },
        {
          "name": "variable.language.salivo",
          "match": "\\b(self|Self)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.salivo",
          "match": "\\b(int|i8|i16|i32|i64|uint|u8|u16|u32|u64|float|f32|f64|bool|string|char|void)\\b"
        },
        {
          "name": "support.type.standard.salivo",
          "match": "\\b(Option|Result|Drop|Display|Debug|Iterator|TaskScope|Task|CancellationToken|Mutex|RwLock|Channel|Vec|HashMap|HashSet|File|StrSlice|ByteSlice|String|Directory|FileMetadata|Socket|TcpStream|TcpListener|UdpSocket|IPAddress|SocketAddress|NetworkError|IoError|Slice|Deque|Heap|Instant|Duration|SqliteConnection|WindowHandle|Asset|GameState|EngineConfig|Request|Response|WebResponse|Router|JsonValue)\\b"
        },
        {
          "name": "entity.name.type.salivo",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.salivo",
          "match": "\\b(true|false|null|None|Some|Ok|Err)\\b"
        }
      ]
    },
    "modifiers": {
      "patterns": [
        {
          "match": "(:)([a-zA-Z0-9_]+)\\b",
          "captures": {
            "1": { "name": "punctuation.separator.modifier.salivo" },
            "2": { "name": "entity.name.function.modifier.salivo" }
          }
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.salivo",
          "match": "\\b(out|outln|print|println|in|input|env|len|str|int|float|trim|upper|lower|slice|strint|strfloat|floatstr|insert|remove|veclen|swapRemove|truncate|reserve|min|max|abs|clamp|pow|sqrt|assert|assertEq|asserteq|assertStrEq|assertstreq|assertNe|assertne|assertStrNe|assertstrne|panic|dbg|some|none|ok|err|vecNew|vecnew|vecCap|veccap|mapNew|mapnew|heapNew|heapnew|btreeNew|btreenew|btSetNew|btsetnew|deqNew|deqnew|push|pop|pushStr|pushstr|pushByte|pushbyte|stringNew|stringnew|stringWithCap|stringwithcap|asStr|asstr|fromStr|fromstr|readStr|readstr|writeStr|writestr|pathJoin|pathjoin|pathExists|pathexists|sha256|sha256Hex|sha256hex|sha512|blake3|mutex|lock|unlock|rwlock|channel|send|recv|epoch|now|sleep|isOpen|isopen|readByte|readbyte|dirExists|direxists|dirList|dirlist)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.interpolated.salivo",
          "begin": "\\$\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.salivo",
              "match": "\\\\([nrt\\\\\"'0]|x[0-9a-fA-F]{2}|u\\{[0-9a-fA-F]+\\})"
            },
            {
              "name": "meta.embedded.expression.salivo",
              "begin": "\\{",
              "end": "\\}",
              "beginCaptures": {
                "0": { "name": "punctuation.definition.template-expression.begin.salivo" }
              },
              "endCaptures": {
                "0": { "name": "punctuation.definition.template-expression.end.salivo" }
              },
              "patterns": [
                { "include": "#modifiers" },
                { "include": "#constants" },
                { "include": "#numbers" },
                { "include": "#builtins" },
                { "include": "#functions" },
                { "include": "#types" },
                {
                  "name": "variable.other.salivo",
                  "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
                }
              ]
            }
          ]
        },
        {
          "name": "string.quoted.double.salivo",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.salivo",
              "match": "\\\\([nrt\\\\\"'0]|x[0-9a-fA-F]{2}|u\\{[0-9a-fA-F]+\\})"
            }
          ]
        },
        {
          "name": "string.quoted.single.salivo",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.salivo",
              "match": "\\\\([nrt\\\\\"'0]|x[0-9a-fA-F]{2})"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.salivo",
          "match": "\\b0x[0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.octal.salivo",
          "match": "\\b0o[0-7_]+\\b"
        },
        {
          "name": "constant.numeric.binary.salivo",
          "match": "\\b0b[01_]+\\b"
        },
        {
          "name": "constant.numeric.float.salivo",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9_]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.salivo",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\bfunc\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
          "captures": {
            "1": { "name": "entity.name.function.salivo" }
          }
        },
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
          "captures": {
            "1": { "name": "entity.name.function.call.salivo" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.salivo",
          "match": "(><|->|=>|\\?\\?|\\?|==|!=|<=|>=|<<|>>|&&|\\|\\||\\+=|-=|\\*=|/=|%=|\\+\\+|--|\\+|-|\\*|/|%|&|\\||\\^|~|!|=|\\.|,|;|:|<|>)"
        }
      ]
    }
  }
}
