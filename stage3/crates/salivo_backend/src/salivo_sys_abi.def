# Salivo Stage 38 system telemetry ABI - the single canonical definition (C: salivo_sys_runtime.c).
#
# Consumers: crates/salivo_common (aio_abi.rs) for the semantic analyzer and the backend, and
# compiler/stage3 (runtimeIntrinsic reads this file for `rtsys*` names).
#
# Every value is a 64-bit integer (`int`) or a NUL-terminated UTF-8 string (`string`). Process
# snapshots, service snapshots, counter queries and counters cross the boundary as small handles.
# Negative `int` results are error codes: -7 invalid argument, -8 OS failure, -10 invalid
# handle, -11 table full, -12 unsupported platform; rtsysterminate returns -<Win32 error>.
# Windows; on Linux the process snapshot, memory, uptime, CPU, pty and system rows work too. The text
# store works everywhere; other platforms report -12 and empty strings.
# Thread-safe: rows marked "any thread (serialized)" share tables and run under one lock.
#
# Columns: intrinsic|c symbol|return|params|blocking|thread safety|ownership & lifetime
@abi_version 38100
rtsysprocsnap|salivo_sys_proc_snap|int||brief (kernel query, window enumeration)|any thread (serialized)|caller owns the snapshot until rtsysprocfree (16 live at most)
rtsysproccount|salivo_sys_proc_count|int|int|never|any thread (serialized)|borrows the snapshot
rtsysprocint|salivo_sys_proc_int|int|int,int,int|never|any thread (serialized)|field 0 pid 1 ppid 2 threads 3 handles 4 session 5 working set 6 private bytes 7 cpu time (100 ns) 8 create time 9 state (0 running 1 suspended 2 not responding) 10 has window 11 io read 12 io write 13 io other (bytes) 14 Linux state letter (R S D Z T I as a byte)
rtsysproctext|salivo_sys_proc_text|string|int,int,int|never|any thread (serialized)|field 0 image name 1 main window title; new string owned by the caller
rtsysprocfree|salivo_sys_proc_free|int|int|never|any thread (serialized)|frees the snapshot
rtsysprocpath|salivo_sys_proc_path|string|int|brief|any thread|full executable path or "" when Windows denies access; new string owned by the caller
rtsysterminate|salivo_sys_terminate|int|int|brief (Linux: up to 300 ms before SIGKILL)|any thread|0 ended; -7 for pid <= 4 (Linux: pid <= 1); -<Win32 error> or -errno otherwise
rtsysheapblocks|salivo_sys_heap_blocks|int|int,int,int|walks every process heap (locks each briefly)|any thread|busy heap blocks with size in [min, max]: which 0 count, 1 bytes
rtsysalive|salivo_sys_alive|int|int|never|any thread|1 while the process exists
rtsyspdhopen|salivo_sys_pdh_open|int||never|any thread (serialized)|caller owns the query until rtsyspdhclose (16 live at most)
rtsyspdhadd|salivo_sys_pdh_add|int|int,string|brief|any thread (serialized)|English counter path (wildcards allowed); the counter lives as long as its query
rtsyspdhcollect|salivo_sys_pdh_collect|int|int|brief|any thread (serialized)|samples every counter of the query; rate counters need two samples
rtsyspdhcount|salivo_sys_pdh_count|int|int|never|any thread (serialized)|instances in the last sample
rtsyspdhname|salivo_sys_pdh_name|string|int,int|never|any thread (serialized)|instance name; new string owned by the caller
rtsyspdhvalue|salivo_sys_pdh_value|int|int,int|never|any thread (serialized)|value x 1000 (12.5 reads 12500)
rtsyspdhclose|salivo_sys_pdh_close|int|int|never|any thread (serialized)|closes the query and its counters
rtsysmem|salivo_sys_mem|int|int|never|any thread|0 physical 1 available 2 installed 3 committed 4 commit limit 5 system cache 6 paged pool 7 non-paged pool (bytes) 8 handles 9 processes 10 threads
rtsysuptimems|salivo_sys_uptime_ms|int||never|any thread|milliseconds since boot
rtsyscpu|salivo_sys_cpu|int|int|brief (kernel query)|any thread|time of all CPUs since boot in 1/100 s: 0 busy, 1 idle; 2 logical CPU count (Windows and Linux)
rtsysregnames|salivo_sys_reg_names|string|int,string|brief|any thread|root 1 HKCU 2 HKLM; value names one per line; new string owned by the caller
rtsysregkeys|salivo_sys_reg_keys|string|int,string|brief|any thread|subkey names one per line; new string owned by the caller
rtsysregstr|salivo_sys_reg_str|string|int,string,string|brief|any thread|string or number value as text, "" when absent; new string owned by the caller
rtsysregbyte|salivo_sys_reg_byte|int|int,string,string,int|brief|any thread|byte at index of a value, -1 when absent
rtsysfileinfo|salivo_sys_file_info|string|string,string|disk|any thread|version resource string (FileDescription, CompanyName, ...); new string owned by the caller
rtsysiconpng|salivo_sys_icon_png|int|string,string|disk|any thread (serialized)|writes the file's 32x32 icon as PNG to the second path; 0 on success
rtsyssvcsnap|salivo_sys_svc_snap|int||brief (service manager queries)|any thread (serialized)|caller owns the snapshot until rtsyssvcfree (4 live at most)
rtsyssvccount|salivo_sys_svc_count|int|int|never|any thread (serialized)|borrows the snapshot
rtsyssvcint|salivo_sys_svc_int|int|int,int,int|never|any thread (serialized)|field 0 state (1 stopped 4 running) 1 pid 2 start type (2 auto 3 manual 4 disabled) 3 delayed auto start
rtsyssvctext|salivo_sys_svc_text|string|int,int,int|never|any thread (serialized)|field 0 name 1 display name; new string owned by the caller
rtsyssvcfree|salivo_sys_svc_free|int|int|never|any thread (serialized)|frees the snapshot
rtsysinfo|salivo_sys_info|string|string|brief (first call per key)|any thread (serialized)|cpu_name computer user gpu_names gpu_drivers disk_model net_name net_desc net_ipv4 net_ipv6; new string owned by the caller
rtsysinfoint|salivo_sys_info_int|int|string|brief (first call per key)|any thread (serialized)|cpu_mhz cpu_sockets cpu_cores cpu_logical cpu_l2_kb cpu_l3_kb cpu_virt mem_speed_mts mem_slots mem_slots_used mem_form gpu_total_mb disk_size_gb disk_ssd disk_count net_link_bps session pid
rtsysopen|salivo_sys_open|int|string|never|any thread|opens a URL or file with its default handler
rtsysreveal|salivo_sys_reveal|int|string|never|any thread|opens Explorer with the file selected; -7 when the file does not exist
rtsystextset|salivo_sys_text_set|int|int,string|never|any thread (serialized)|copies the text into slot 0..65535 (runtime memory, survives request heaps); frees the slot's previous text
rtsystextget|salivo_sys_text_get|string|int|never|any thread (serialized)|copy of the slot's text ("" when empty); new string owned by the caller
rtsysfilestat|salivo_sys_file_stat|int|string,int|brief (file system query)|any thread|stat of a path: 0 size in bytes, 1 modified time (Unix seconds), 2 is a directory (1/0); -errno when it does not exist (all platforms)
rtsysstat|salivo_sys_stat|int|int|brief (reads /sys)|any thread|Linux machine counters: 0 disk bytes read 1 disk bytes written 2 disk busy ms 3 disk capacity bytes 4 net bytes received 5 net bytes sent 6 fastest link Mbps (0 unknown, -1 none up) 7 CPU MHz 8 GPU busy % (-1 unknown) 9 battery % (-1 none) 10 on mains (1/0, -1 unknown) 11 wireless up (1/0) 12 GPU milli degrees C (-1 unknown) 13 physical disks
rtsysbyte|salivo_sys_byte|string|int|never|any thread|one-byte string holding the byte 1..255 ("" otherwise; all platforms); new string owned by the caller
rtsysargc|salivo_sys_argc|int||never|any thread|number of command-line arguments, the program itself included (all platforms)
rtsysargv|salivo_sys_argv|string|int|never|any thread|argument i (0 = the program), UTF-8; "" out of range; new string owned by the caller
rtsysrun|salivo_sys_run|int|string,string|until the child exits|any thread|runs a command through the system shell with the given stdin text, capturing stdout and stderr; caller owns the result handle until rtsysrunfree (64 live at most); -7 empty command, -8 could not start
rtsysruncode|salivo_sys_run_code|int|int|never|any thread|the child's exit code
rtsysrunout|salivo_sys_run_out|string|int|never|any thread|captured stdout; new string owned by the caller
rtsysrunerr|salivo_sys_run_err|string|int|never|any thread|captured stderr; new string owned by the caller
rtsysrunfree|salivo_sys_run_free|int|int|never|any thread|frees the result
# Stage 38.1 desktop windowing / canvas and 38.2 game rendering (salivo_gfx_runtime.inc, Win32 + OpenGL).
# Window, texture, mesh and shader values are generation handles; a destroyed handle reports -10 forever.
# The first thread that creates a window owns all of these calls (-13 elsewhere). More codes: -14 resource
# of another window, -15 invalid state, -16 asset not found, -17 invalid asset, -18 shader failure, -19 graphics failure.
rtsyswincreate|salivo_sys_win_create|int|string,int,int|brief (creates the OS window and OpenGL context)|platform thread|caller owns the hidden window until rtsyswindestroy; client size in physical pixels (1..16384)
rtsyswindestroy|salivo_sys_win_destroy|int|int|brief|platform thread|destroys the window's textures, meshes and shaders, its queued events, its context and the OS window; -10 when already destroyed
rtsyswinshow|salivo_sys_win_show|int|int,int|brief|platform thread|mode 0 hide 1 show 2 minimize 3 maximize 4 restore 5 focus (-15 when hidden)
rtsyswintitle|salivo_sys_win_title|int|int,string|never|platform thread|UTF-8 title, 4096 bytes at most
rtsyswinresize|salivo_sys_win_resize|int|int,int,int|brief|platform thread|client size in physical pixels; -15 while fullscreen
rtsyswinmove|salivo_sys_win_move|int|int,int,int|brief|platform thread|outer top-left in screen pixels; -15 while fullscreen
rtsyswinint|salivo_sys_win_int|int|int,int|never|platform thread|0 client width 1 client height 2 x 3 y 4 shown 5 fullscreen 6 minimized 7 focused 8 DPI scale x1000 9 in frame
rtsyswinfullscreen|salivo_sys_win_fullscreen|int|int,int|brief|platform thread|1 borderless fullscreen on the window's monitor, 0 restores the previous placement
rtsyswinvsync|salivo_sys_win_vsync|int|int,int|never|platform thread|1 waits for vertical blank in present (default), 0 does not; -12 without WGL_EXT_swap_control
rtsysevpoll|salivo_sys_ev_poll|int||never|platform thread|pumps OS messages; next event type or 0: 1 close 2 resize(a w, b h, c state 0 normal 1 minimized 2 maximized) 3 move(x,y) 4 focus(a 1/0) 5 key down(a vk, b scancode, c repeat) 6 key up(a vk, b scancode) 7 text(a code point) 8 mouse move(x,y) 9 button down(a button, x,y) 10 button up 11 wheel(a delta, x,y)
rtsysevwait|salivo_sys_ev_wait|int|int|until an OS message, an event or the timeout (ms)|platform thread|as rtsysevpoll after waiting without spinning
rtsysevfield|salivo_sys_ev_field|int|int|never|platform thread|field of the current event: 0 window 1 a 2 b 3 c 4 x 5 y
rtsyskeydown|salivo_sys_key_down|int|int|never|platform thread|1 while the virtual key is held; focus loss releases every key
rtsysmouse|salivo_sys_mouse|int|int|never|platform thread|0 x 1 y (client pixels) 2 buttons (bit 1 left 2 right 3 middle) 3 window
rtsysframebegin|salivo_sys_frame_begin|int|int|never|platform thread|starts a frame: viewport = client size, pixel projection (origin top-left); -15 inside a frame
rtsysframeclear|salivo_sys_frame_clear|int|int,int|GPU|platform thread|clears color (0xRRGGBBAA) and depth; -15 outside a frame
rtsysframerect|salivo_sys_frame_rect|int|int,int,int,int,int,int|GPU|platform thread|filled rectangle x,y,w,h,rgba in pixels (under the 2D camera when one is set)
rtsysframepixel|salivo_sys_frame_pixel|int|int,int,int|waits for the GPU|platform thread|pixel of the frame being drawn as 0xRRGGBBFF
rtsysframepresent|salivo_sys_frame_present|int|int|until vertical blank when vsync is on|platform thread|ends the frame and swaps buffers
rtsysframeround|salivo_sys_frame_round|int|int,int,int,int,int,int,int|never|platform thread|filled rounded rectangle x,y,w,h, corner radius, rgba in screen pixels (anti-aliased on Linux)
rtsysframering|salivo_sys_frame_ring|int|int,int,int,int,int,int|never|platform thread|circle outline centered on cx,cy with radius r and line thickness in screen pixels, rgba (anti-aliased on Linux); a thickness >= r fills the disc
rtsysframeclip|salivo_sys_frame_clip|int|int,int,int,int,int|never|platform thread|clip rectangle x,y,w,h in screen pixels for the rest of the frame; a negative width or height clears it
rtsystexscale|salivo_sys_tex_scale|int|int,int,int|resamples every texel|platform thread|new texture (same window) holding the texture resized to w,h: area average when shrinking, bilinear when growing; -7 for a font
rtsystexshm|salivo_sys_tex_shm|int|int,string,int,int|maps the file|platform thread|texture (same window) whose w*h 0xAARRGGBB opaque pixels are a shared-memory file another process draws into; every draw reads the file (no copy); Linux only (-12 elsewhere); -16 missing file, -17 file smaller than w*h*4
rtsystimeus|salivo_sys_time_us|int||never|any thread|monotonic microseconds
rtsyscam2d|salivo_sys_cam2d|int|int,int,int,int,int|never|platform thread|2D camera for the rest of the frame: center x, y, zoom x1000, rotation degrees
rtsystexcreate|salivo_sys_tex_create|int|int,int,int|GPU upload|platform thread|transparent texture owned by the window; -7 for sizes outside 1..GL_MAX_TEXTURE_SIZE
rtsystexload|salivo_sys_tex_load|int|int,string|disk + GPU upload|platform thread|uncompressed 24/32-bit BMP; -16 missing file, -17 invalid image
rtsystexpixel|salivo_sys_tex_pixel|int|int,int,int,int|never|platform thread|sets one texel (uploaded on next use)
rtsystexsize|salivo_sys_tex_size|int|int,int|never|platform thread|0 width 1 height
rtsystexdestroy|salivo_sys_tex_destroy|int|int|GPU|platform thread|frees the texture; -10 when already destroyed
rtsysdrawquad|salivo_sys_draw_quad|int|int,int,int,int,int,int,int,int|GPU|platform thread|quad centered on x,y with w,h, rotation degrees, tint rgba, texture or 0; -15 under a 3D camera
rtsysmeshcreate|salivo_sys_mesh_create|int|int|never|platform thread|empty triangle-list mesh owned by the window; -12 without OpenGL 1.5 buffers
rtsysmeshvertex|salivo_sys_mesh_vertex|int|int,int,int,int,int,int,int|never|platform thread|appends x,y,z (milli-units), rgba, u,v (x1000); returns the vertex count
rtsysmeshcount|salivo_sys_mesh_count|int|int|never|platform thread|vertex count
rtsysmeshdestroy|salivo_sys_mesh_destroy|int|int|GPU|platform thread|frees the mesh and its GPU buffer
rtsysshadercreate|salivo_sys_shader_create|int|int,string,string|driver compile|platform thread|GLSL vertex + fragment program owned by the window; -18 with the log in rtsysshaderlog
rtsysshaderlog|salivo_sys_shader_log|string||never|platform thread|compile/link log of the last failed rtsysshadercreate; new string owned by the caller
rtsysshaderdestroy|salivo_sys_shader_destroy|int|int|GPU|platform thread|frees the program
rtsyscam3d|salivo_sys_cam3d|int|int,int,int,int,int,int,int,int,int,int|never|platform thread|perspective camera: eye xyz, target xyz (milli-units, up +Y), fov degrees, near, far (milli-units); enables depth test
rtsysdrawmesh|salivo_sys_draw_mesh|int|int,int,int,int,int,int,int,int,int,int,int,int|GPU|platform thread|mesh, shader or 0, position xyz (milli), rotation x,y,z degrees, scale x1000, tint rgba, texture or 0; -15 without camera3d
rtsysgfxstat|salivo_sys_gfx_stat|int|int|never|platform thread|0 windows 1 textures (fonts included) 2 meshes 3 shaders (live) 4 draw calls 5 dropped events 6 queued events 7 sounds (live)
rtsysgfxinfo|salivo_sys_gfx_info|string|int,int|never|platform thread|OpenGL vendor (0), renderer (1) or version (2) of the window's context; "" for an invalid handle; new string owned by the caller
# Stage 38.3 engine layer (salivo_gfx_runtime.inc): sprite-sheet regions, GDI glyph-atlas fonts (a font is a window-owned texture),
# MCI audio. textureLoad also decodes PNG, JPEG, GIF and TIFF through GDI+. Sounds are generation handles not owned by a window.
rtsyscamscreen|salivo_sys_cam_screen|int|int|never|platform thread|screen pixels (origin top-left) for the rest of the frame, dropping a 2D or 3D camera; -15 outside a frame
rtsysdrawregion|salivo_sys_draw_region|int|int,int,int,int,int,int,int,int,int,int,int,int|GPU|platform thread|quad centered on x,y with w,h (negative mirrors), rotation degrees, tint rgba, texture, showing its texel rectangle sx,sy,sw,sh; -7 rectangle outside the texture
rtsysfontload|salivo_sys_font_load|int|int,string,int|disk + rasterize + GPU upload|platform thread|font from a .ttf/.otf/.ttc file or an installed family name, em height 4..256 px; a texture owned by the window; -16 missing file or unknown family, -17 unreadable font file
rtsysdrawtext|salivo_sys_draw_text|int|int,int,string,int,int,int|GPU|platform thread|UTF-8 text with its top-left at x,y in rgba; newline starts a line; code points outside 32..255 draw as ?; returns the widest line in pixels; -7 a texture that is not a font
rtsystextsize|salivo_sys_text_size|int|int,string,int|never|platform thread|0 widest line in pixels 1 height (lines x line height)
rtsyssoundload|salivo_sys_sound_load|int|string|disk + decoder start|platform thread|caller owns the sound until rtsyssounddestroy; WAV, MP3 or any DirectShow format; -16 missing file, -17 not decodable
rtsyssoundplay|salivo_sys_sound_play|int|int,int|never (plays asynchronously)|platform thread|plays from the start, 1 loops until stopped
rtsyssoundstop|salivo_sys_sound_stop|int|int|never|platform thread|stops and rewinds
rtsyssoundvolume|salivo_sys_sound_volume|int|int,int|never|platform thread|volume 0..1000
rtsyssoundint|salivo_sys_sound_int|int|int,int|never|platform thread|0 playing 1 length ms 2 position ms 3 volume
rtsyssounddestroy|salivo_sys_sound_destroy|int|int|brief|platform thread|closes the sound; -10 when already destroyed
# Linux system primitives for Salivo OS (init, services, power). Other platforms report -12.
rtsysmount|salivo_sys_mount|int|string,string,string,int|brief (kernel call)|any thread|mount(2): source, target, filesystem type, flags (MS_* bits); 0 or -errno
rtsysspawn|salivo_sys_spawn|int|string,string,string|fork + exec|any thread|runs path with newline-separated args (argv[0] included) in a new session; tty path becomes stdin/out/err and the controlling terminal ("" inherits ours); pid or -errno
rtsysreap|salivo_sys_reap|int|int|until a child exits when block is 1|any thread|waits for any child: pid of the reaped child, 0 none ready (block 0), -10 no children
rtsyspower|salivo_sys_power|int|int|never returns on success|any thread|syncs disks then 0 powers off, 1 reboots; -errno on failure
rtsyshostname|salivo_sys_hostname|int|string|never|any thread|sethostname(2); 0 or -errno
rtsysptyopen|salivo_sys_pty_open|int|string,string,int,int|fork + exec|any thread|runs path (newline-separated args, argv[0] first) on a new pseudo-terminal of cols x rows with TERM=xterm-256color; caller owns the handle until rtsysptyclose (16 live at most); -errno on failure
rtsysptyread|salivo_sys_pty_read|string|int|never|any thread|output the program wrote since the last read ("" when none); never blocks; new string owned by the caller
rtsysptyready|salivo_sys_pty_ready|int|int|never|any thread|1 when output is waiting or the program hung up, 0 otherwise (check before rtsysptyread to skip empty reads)
rtsysptywrite|salivo_sys_pty_write|int|int,string|until the terminal accepts the bytes|any thread|types text into the terminal (keys, escape sequences); bytes written or -errno
rtsysptyresize|salivo_sys_pty_resize|int|int,int,int|never|any thread|new size in cols x rows (the program gets SIGWINCH)
rtsysptystate|salivo_sys_pty_state|int|int|never|any thread|1 while the program runs, 0 after it exited (reaped here); -10 invalid handle
rtsysptyclose|salivo_sys_pty_close|int|int|brief|any thread|hangs up the terminal (SIGHUP) and frees the handle
